datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt
}

model Room {
  id             Int      @id @default(autoincrement())
  name           String
  description    String
  price          String
  image          String
  maxGuests      Int
  rooms          Int?
  beds           Int
  bedType        String?
  bedrooms       Int?
  bathrooms      Int
  hasPrivatePool Boolean  @default(false)
  hasKitchen     Boolean  @default(false)
  hasWifi        Boolean  @default(false)
  hasParking     Boolean  @default(false)
  hasAC          Boolean  @default(false)
  checkInTime    String
  checkOutTime   String
}